# Copy this file to .env and fill in your own values.
# None of these are required to boot the server — GROQ_API_KEY is optional
# because users can instead paste their key in the app's Settings page.

# --- LLM (Groq, OpenAI-compatible) ---
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
CHAT_MODEL=llama-3.3-70b-versatile

# --- Optional image generation (Groq is text-only — separate provider) ---
# Leave blank to keep the Image Generation feature disabled.
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=dall-e-3

# --- Database (optional; falls back to in-memory store if empty) ---
MONGO_URI=
MONGO_DB_NAME=content_generator

# --- RAG / vector store (TF-IDF based, no external model download) ---
VECTOR_STORE_PATH=./data/vector_store

# --- Auth ---
# Change this to a long random string in production — anyone with this
# secret can forge login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_EXPIRE_MINUTES=10080
# The first account registered with this email is auto-promoted to admin.
# Leave blank to disable (promote a user manually in the database instead).
ADMIN_EMAIL=

# --- Caching (optional; falls back to in-memory if empty) ---
REDIS_URL=
CACHE_TTL_SECONDS=900

# --- Rate limiting ---
RATE_LIMIT_GENERATE=20/minute
RATE_LIMIT_DEFAULT=60/minute

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGINS=http://localhost:5173
